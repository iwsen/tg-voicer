# ==============================================================================
# TG-Voicer .gitignore
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/
.env/

# Telegram credentials & Session files
*.session
*.session-journal
*.session-wal
*.session-shm
temp.session
.env
*.env

# Local configuration with user secret API credentials
config.toml

# Application runtime data (databases, logs, QR SVGs, PID files, caches)
data/*
!data/.gitkeep
*.log
*.pid
*.db
*.db-wal
*.db-shm

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
